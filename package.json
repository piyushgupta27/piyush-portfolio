{
  "name": "piyush-portfolio",
  "version": "0.1.0",
  "description": "Personal portfolio site for Piyush Gupta — Sr Engineering Manager",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
