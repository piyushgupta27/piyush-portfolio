# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local
.env.local
.env*.local
.vercel

# playwright
/playwright-report/
/test-results/

# ai-sdlc agent state (machine-local)
.audit/
.sdlc-queue/

# third-party agentic tool state and build artifacts (machine-local; biome useIgnoreFile skips these)
.agents/
.codegraph/
.codex/
.impeccable/
.playwright-mcp/
graphify-out/

# gstack local artifacts
.gstack/

# local recordings
*.mov

# machine-local continuation doc pointer (absolute path, never commit)
.continuation-doc-path

# internal planning docs — belong in vault, never public repo
tasks/continuation.md
tasks/lessons.md
tasks/session-*.md

# claude code local settings and tool artifacts (machine-local)
.claude/
skills-lock.json

# design review screenshots (binary assets, belong in vault not repo)
docs/design-review-*/screenshots/

# repomix output
repomix-output.*
